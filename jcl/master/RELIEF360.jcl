//RELIEF36 JOB (R360,MASTER),'MASTER BATCH FLOW',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    RELIEF360 (MASTER BATCH STREAM)
//* DESCRIPTION: ORCHESTRATES THE COMPLETE SEQUENTIAL BATCH PIPELINE:
//*              1. PREP-APP (DFSORT DEDUPLICATION)
//*              2. VALIDATE-COUNT (QUALITY GATE)
//*              3. VALID (AT01VAL)
//*              4. ELIG (AT02ELIG)
//*              5. RECON (AT04REC)
//*              6. AUDIT (AT05OPS)
//*              7. REPORT (AT06RPT)
//*              8. MONITOR (REXX POST-RUN CHECK)
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=COPY
/*
//*
//STEP02   EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  /* QUALITY GATE RECORD COUNT CHECK */
/*
//*
//STEP03   EXEC PGM=AT01VAL,COND=(4,LT)
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP04   EXEC PGM=AT02ELIG,COND=(4,LT)
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP05   EXEC PGM=AT04REC,COND=(4,LT)
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP06   EXEC PGM=AT05OPS,COND=(4,LT)
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP07   EXEC PGM=AT06RPT,COND=(4,LT)
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//
