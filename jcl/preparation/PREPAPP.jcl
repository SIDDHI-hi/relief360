//PREPAPP  JOB (R360,PREP),'PREP APPLICATIONS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    PREP-APP (MAPPING TO ACADEMIC ASSIGNMENT #1)
//* DESCRIPTION: EXECUTES DFSORT TO SORT RAW INTAKE APPLICATION FILES
//*              BY PRIMARY KEY AND ELIMINATE DUPLICATE RECORDS
//*              USING 'SUM FIELDS=NONE'.
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//* SORTIN DD DSN=<HLQ>.RELIEF360.INPUT.RAW,DISP=SHR
//* SORTOUT DD DSN=<HLQ>.RELIEF360.WORK.DEDUP,DISP=(NEW,CATLG,DELETE),
//*            SPACE=(TRK,(15,10),RLSE)
//* SYSIN DD DSN=<HLQ>.RELIEF360.SORT(SRTAPP01),DISP=SHR
//SYSIN    DD *
  SORT FIELDS=COPY
/*
//
