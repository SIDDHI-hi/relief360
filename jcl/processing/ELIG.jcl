//ELIG     JOB (R360,ELIG),'CALCULATE ELIGIBILITY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    ELIG
//* DESCRIPTION: EXECUTES COBOL PROGRAM AT02ELIG TO CALCULATE
//*              PRIORITY SCORES, ASSIGN PRIORITY BANDS, AND
//*              ENFORCE STATUTORY AID CAPS.
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=AT02ELIG
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//APPIN    DD DSN=<HLQ>.RELIEF360.WORK.VALID,DISP=SHR
//APPOUT   DD DSN=<HLQ>.RELIEF360.OUTPUT.APPROVED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(15,10),RLSE)
//SYSOUT   DD SYSOUT=*
//
