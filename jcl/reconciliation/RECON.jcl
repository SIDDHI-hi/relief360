//RECON    JOB (R360,RECON),'PAYMENT RECON',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    RECON (MAPPING TO ACADEMIC ASSIGNMENT #2)
//* DESCRIPTION: EXECUTES COBOL PROGRAM AT04REC TO PERFORM TWO-FILE
//*              SEQUENTIAL MATCHING BETWEEN APPROVED ALLOCATIONS AND
//*              ACTUAL BANK PAYMENT TRANSACTION FILES.
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=AT04REC
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//APPFILE  DD DSN=<HLQ>.RELIEF360.OUTPUT.APPROVED,DISP=SHR
//PAYFILE  DD DSN=<HLQ>.RELIEF360.INPUT.PAYMENTS,DISP=SHR
//RECFILE  DD DSN=<HLQ>.RELIEF360.OUTPUT.RECON,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(15,10),RLSE)
//MISFILE  DD DSN=<HLQ>.RELIEF360.EXCEPTIONS.MISMATCH,DISP=(MOD,CATLG)
//SYSOUT   DD SYSOUT=*
//
