//REPORT   JOB (R360,RPT),'REPORT GENERATION',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    REPORT
//* DESCRIPTION: EXECUTES COBOL PROGRAM AT06RPT TO PRODUCE FORMATTED
//*              MANAGEMENT SUMMARIES, EXCEPTION LISTINGS, AND
//*              RECONCILIATION BALANCE AUDIT REPORTS.
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=AT06RPT
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//RECONIN  DD DSN=<HLQ>.RELIEF360.OUTPUT.RECON,DISP=SHR
//RPTFILE  DD DSN=<HLQ>.RELIEF360.REPORTS.SUMMARY,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5),RLSE)
//SYSOUT   DD SYSOUT=*
//
