//VALID    JOB (R360,VALID),'VALIDATE APPS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* SYSTEM:      RELIEF360 - EMERGENCY RELIEF ALLOCATION
//* JOB NAME:    VALID
//* DESCRIPTION: EXECUTES COBOL PROGRAM AT01VAL TO VALIDATE APPLICANT
//*              DATA, ELIGIBILITY CRITERIA, AND BANK ACCOUNT ROUTING.
//*
//* LEAD:        ANANYA (JCL & BATCH LEAD)
//* INTEGRATION: SIDDHI
//*
//* NOTE:        THIS IS A PHASE 0 IMPLEMENTATION PLACEHOLDER.
//*-------------------------------------------------------------------*
//STEP01   EXEC PGM=AT01VAL
//STEPLIB  DD DSN=<HLQ>.RELIEF360.LOAD,DISP=SHR
//APPIN    DD DSN=<HLQ>.RELIEF360.WORK.DEDUP,DISP=SHR
//APPOUT   DD DSN=<HLQ>.RELIEF360.WORK.VALID,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(15,10),RLSE)
//EXPERR   DD DSN=<HLQ>.RELIEF360.EXCEPTIONS,DISP=(MOD,CATLG)
//SYSOUT   DD SYSOUT=*
//
